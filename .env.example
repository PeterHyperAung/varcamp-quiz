# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in real values. Never commit real secrets.
# ---------------------------------------------------------------------------

# Neon PostgreSQL connection string (pooled or direct).
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Used to sign administrator session cookies. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET="replace-me-with-at-least-32-random-characters"

# Default timezone used for seeded content and admin form defaults.
DISPLAY_TIMEZONE="Asia/Yangon"

# ---------------------------------------------------------------------------
# Development seed only (`pnpm db:seed`).
# Required to create the first administrator; ignored at runtime.
# ---------------------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL="organiser@varcamp.test"
ADMIN_BOOTSTRAP_PASSWORD="change-this-development-password"
